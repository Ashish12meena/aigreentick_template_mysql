# =====================================================================================
# template-service — environment variables (generated from application*.yml; keep in sync)
#
#   cp .env.example .env        then uncomment ONLY what you need to change.
#
# Precedence, highest first: real environment variables > ./.env > ../platform.env >
# the defaults in application*.yml (shown below). A commented line keeps its default.
# NEVER write an empty value (VAR=): an empty value REPLACES the default with "".
# No inline comments: in this format '#' starts a comment only at the start of a line.
# .env is git-ignored; never commit real values. See docs/configuration in the platform docs.
# =====================================================================================

# ---- Profile -------------------------------------------------------------------------------
# Path of the shared platform.env (default ../platform.env, relative to the working directory).
# APARGO_PLATFORM_ENV=../platform.env
# Spring profile: dev on a developer machine / dev server, prod in production.
# SPRING_PROFILES_ACTIVE=dev

# ---- Shared infrastructure — normally set ONCE in ../platform.env; set here only to override for this service ---
# Platform MySQL host (DB_HOST overrides it for this service only).
#   (prod profile: required, no default)
# MYSQL_HOST=localhost
# Platform MySQL port (DB_PORT overrides it for this service only).
# MYSQL_PORT=3306
# Platform database name — apargo_wa_messaging in production (DB_NAME overrides it for this service only).
#   (prod profile: required, no default)
# MYSQL_DATABASE=apargo_wa_template
# Kafka brokers, host:port[,host:port].
#   (prod profile: required, no default)
# KAFKA_BOOTSTRAP_SERVERS=146.88.24.113:9092
# TEMPLATE_SERVICE_PORT=8080
# Meta Graph API base URL.
# META_GRAPH_BASE_URL=https://graph.facebook.com
# Meta Graph API version, e.g. v23.0.
# META_GRAPH_API_VERSION=v23.0
# WABA_SERVICE_URL=http://146.88.24.113:8040
# STORAGE_SERVICE_URL=http://146.88.24.113:8030
# Eureka server URL.
#   (prod profile: required, no default)
# EUREKA_DEFAULT_ZONE=http://146.88.24.113:8761/eureka/

# ---- Database (this service) ---------------------------------------------------------------
# Full JDBC URL. When set it wins over every DB_* / MYSQL_* part below.
#   (prod profile default: jdbc:mysql://<MYSQL_HOST>:3306/<MYSQL_DATABASE>)
# DB_URL=jdbc:mysql://localhost:3306/apargo_wa_template
# This service's MySQL host, if different from MYSQL_HOST.
#   (prod profile default: <MYSQL_HOST>)
# DB_HOST=localhost
# This service's MySQL port, if different from MYSQL_PORT.
# DB_PORT=3306
# This service's database. Locally each service has its own; production uses apargo_wa_messaging.
#   (prod profile default: <MYSQL_DATABASE>)
# DB_NAME=apargo_wa_template
# MySQL user for this service.
#   (prod profile default: <SPRING_DATASOURCE_USERNAME>)
# DB_USERNAME=root
# MySQL password for this service.
# DB_PASSWORD=<secret>
# Hikari maximum pool size.
#   (prod profile default: 30)
# DB_POOL_MAX=20
# Hikari minimum idle connections.
# DB_POOL_MIN_IDLE=10
# DB_CONNECTION_TIMEOUT_MS=30000
# DB_IDLE_TIMEOUT_MS=600000
# DB_MAX_LIFETIME_MS=1800000
# DB_POOL_NAME=template-hikari
# Hibernate ddl-auto (update in dev; the prod profile pins validate where it has one).
# JPA_DDL_AUTO=update

# ---- Internal API auth and encryption — disabled for now, ready to enable ------------------
#   (prod profile: required, no default)
# INTERNAL_API_KEY=<secret>
# Internal API-key auth for /internal/** — false for now; set true together with the keys to enable it.
# INTERNAL_API_AUTH_ENABLED=false
# WABA_SERVICE_API_KEY=<secret>
# STORAGE_SERVICE_API_KEY=<secret>

# ---- Service settings ----------------------------------------------------------------------
# SPRING_APPLICATION_NAME=template-service
# Print SQL to stdout.
#   (dev profile default: true)
# JPA_SHOW_SQL=false
# JPA_FORMAT_SQL=true
# JPA_BATCH_SIZE=50
# KAFKA_CLIENT_ID=<spring.application.name>
# KAFKA_DELIVERY_TIMEOUT_MS=120000
# KAFKA_MAX_BLOCK_MS=10000
# MAX_FILE_SIZE=16MB
# MAX_REQUEST_SIZE=64MB
# HTTP port for this service only; normally the port comes from <NAME>_SERVICE_PORT in ../platform.env.
# SERVER_PORT=8080
# FACEBOOK_CONNECT_TIMEOUT_MS=10000
# FACEBOOK_READ_TIMEOUT_MS=30000
# FACEBOOK_MAX_IN_MEMORY_BYTES=16777216
# FACEBOOK_TEMPLATE_PAGE_SIZE=200
# WABA_CONNECT_TIMEOUT_MS=5000
# WABA_READ_TIMEOUT_MS=10000
# WABA_MAX_IN_MEMORY_BYTES=1048576
# WABA_CREDENTIALS_PATH=/internal/v1/waba-credentials/by-waba/{wabaId
# MEDIA_CONNECT_TIMEOUT_MS=5000
# MEDIA_READ_TIMEOUT_MS=60000
# MEDIA_MAX_IN_MEMORY_BYTES=2097152
# MEDIA_BATCH_UPLOAD_PATH=/api/v1/media/upload/batch
# MEDIA_BATCH_MAX_BYTES=83886080
# MEDIA_BATCH_MAX_FILES=20
# MEDIA_SINGLE_UPLOAD_PATH=/api/v1/media/upload
# MEDIA_SYNC_POOL_SIZE=15
# MEDIA_SYNC_QUEUE_CAPACITY=100
# MEDIA_SYNC_KEEP_ALIVE_SECONDS=60
# MEDIA_SYNC_AWAIT_TERMINATION_SECONDS=30
# MEDIA_SYNC_THREAD_NAME_PREFIX=media-sync-
# TEMPLATE_RECONCILE_ENABLED=false
# TEMPLATE_RECONCILE_INTERVAL=PT5M
# TEMPLATE_RECONCILE_INITIAL_DELAY=PT2M
# TEMPLATE_RECONCILE_MIN_AGE=PT5M
# TEMPLATE_RECONCILE_GIVE_UP_AFTER=PT30M
# TEMPLATE_RECONCILE_BATCH_SIZE=50
# IDEMPOTENCY_REQUIRED=true
# IDEMPOTENCY_TTL=PT24H
# IDEMPOTENCY_IN_PROGRESS_TIMEOUT=PT5M
# IDEMPOTENCY_PURGE_INTERVAL=PT1H
# IDEMPOTENCY_PURGE_INITIAL_DELAY=PT1M
# AUDIT_ENABLED=true
# AUDIT_SOURCE_SERVICE=<spring.application.name>
# development | staging | production (the audit service dead-letters a mismatch).
#   (prod profile default: production)
# AUDIT_ENVIRONMENT=development
# AUDIT_TOPIC=apargo.audit.events
# AUDIT_PUBLISHER_POOL_SIZE=2
# AUDIT_PUBLISHER_QUEUE_CAPACITY=10000
# AUDIT_PUBLISHER_AWAIT_TERMINATION_SECONDS=15
# AUDIT_PUBLISHER_THREAD_NAME_PREFIX=audit-publisher-
# Comma-separated browser origins; * = any.
#   (prod profile: required, no default)
# CORS_ALLOWED_ORIGINS=*
# CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# CORS_ALLOWED_HEADERS=*
# CORS_EXPOSED_HEADERS=X-Request-Id,Location,Retry-After
# CORS_ALLOW_CREDENTIALS=true
# CORS_MAX_AGE_SECONDS=3600
# Register with Eureka.
# EUREKA_ENABLED=true
# Register this instance in Eureka.
# EUREKA_REGISTER_WITH_EUREKA=true
# Fetch the Eureka registry.
# EUREKA_FETCH_REGISTRY=true
# Register with the IP address instead of the hostname.
# EUREKA_PREFER_IP_ADDRESS=true
# Actuator endpoints exposed over HTTP, comma-separated.
#   (prod profile default: health,info,metrics,prometheus)
# MANAGEMENT_ENDPOINTS=health,info,metrics
# Health details: never | when-authorized | always.
#   (prod profile default: never)
# MANAGEMENT_HEALTH_DETAILS=when-authorized
# SPRINGDOC_API_DOCS_PATH=/v3/api-docs
# SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html
# SPRINGDOC_PATHS_TO_MATCH=/api/**,/internal/**
# Root log level.
#   (prod profile default: WARN)
# LOG_LEVEL_ROOT=INFO
# Log level of this service's own packages.
#   (prod profile default: INFO)
# LOG_LEVEL_APP=DEBUG
# org.hibernate.orm.jdbc.bind log level (TRACE prints bound parameters).
# LOG_LEVEL_SQL_BIND=TRACE
# TOMCAT_MAX_THREADS=200
# TOMCAT_ACCEPT_COUNT=100
# Serve OpenAPI docs and Swagger UI.
# SWAGGER_ENABLED=false

# ---- Older names — still honoured as fallbacks, use the new name instead -------------------
# SPRING_DATASOURCE_URL  ->  use DB_URL
# SPRING_DATASOURCE_USERNAME  ->  use DB_USERNAME
# SPRING_DATASOURCE_PASSWORD  ->  use DB_PASSWORD
# DB_POOL_MAX_SIZE  ->  use DB_POOL_MAX
# FACEBOOK_SERVICE_BASE_URL  ->  use META_GRAPH_BASE_URL
# FACEBOOK_API_VERSION  ->  use META_GRAPH_API_VERSION
# WABA_SERVICE_BASE_URL  ->  use WABA_SERVICE_URL
# MEDIA_SERVICE_BASE_URL  ->  use STORAGE_SERVICE_URL
# EUREKA_REGISTER  ->  use EUREKA_REGISTER_WITH_EUREKA
# ACTUATOR_ENDPOINTS  ->  use MANAGEMENT_ENDPOINTS
# ACTUATOR_HEALTH_SHOW_DETAILS  ->  use MANAGEMENT_HEALTH_DETAILS
# LOG_LEVEL  ->  use LOG_LEVEL_APP
# SWAGGER_UI_ENABLED  ->  use SWAGGER_ENABLED
